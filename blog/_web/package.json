{
  "name": "growse.com-blog",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:growse/growse.com-blog.git",
  "author": "Andrew Rowson <github@growse.com>",
  "license": "MIT",
  "private": true,
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && webpack --config webpack.config.prod.ts",
    "builddev": "tsc --noEmit && webpack --config webpack.config.dev.ts",
    "typecheck": "tsc --noEmit",
    "watch": "webpack --watch --config webpack.config.dev.ts",
    "index": "pagefind --site ../_site"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/webpack": "^5",
    "clean-webpack-plugin": "^4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.0.0",
    "file-loader": "^6",
    "imagemin-webp-webpack-plugin": "^3.3.6",
    "mini-css-extract-plugin": "^2",
    "pagefind": "^1.5.2",
    "prettier": "^3",
    "resolve-url-loader": "^5",
    "sass": "^1",
    "sass-loader": "^17.0.0",
    "style-loader": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "webpack": "^5.92.0",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.0"
  },
  "dependencies": {
    "vanilla-lazyload": "^19"
  },
  "allowScripts": {
    "cwebp-bin@6.1.2": true,
    "gif2webp-bin@3.0.3": true,
    "esbuild@0.28.2": true
  }
}
