{
  "name": "growse.com-blog",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:growse/growse.com-blog.git",
  "author": "Andrew Rowson <github@growse.com>",
  "license": "MIT",
  "private": true,
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/fonts.mjs && webpack --config webpack.config.prod.ts && node scripts/images.mjs",
    "builddev": "tsc --noEmit && node scripts/fonts.mjs && webpack --config webpack.config.dev.ts && node scripts/images.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "node scripts/fonts.mjs && webpack --watch --config webpack.config.dev.ts",
    "index": "pagefind --site ../_site"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/webpack": "^5",
    "clean-webpack-plugin": "^4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.0.0",
    "file-loader": "^6",
    "mini-css-extract-plugin": "^2",
    "pagefind": "^1.5.2",
    "prettier": "^3",
    "resolve-url-loader": "^5",
    "sass": "^1",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.5",
    "style-loader": "^4",
    "subset-font": "^2.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "webpack": "^5.92.0",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
